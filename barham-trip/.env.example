# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Both values are safe to expose to the browser. No service-role key is needed.
#
# If these are left blank the app still runs fully offline-first with local-only
# state (great for previewing); auth + shared ticks activate once they're set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
