# Copy to .env.local and fill in from your Supabase project settings.
# If these are left blank the app still runs fully offline-first with local-only
# state (great for previewing); auth + shared ticks activate once they're set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/seed_family.ts. NEVER expose to the client.
# (Do not prefix with VITE_.)
SUPABASE_SERVICE_ROLE_KEY=
